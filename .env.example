# Copy to .env and fill in. .env is git-ignored: never commit it.
# Loaded by docker/docker-compose.dev.yml and docker/docker-compose.yml, then
# mapped onto the configuration by config/custom-environment-variables.yml.

# Amazon Creators API credentials (required to fetch products)
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_CREDENTIAL_VERSION=3.2
AMAZON_PARTNER_TAG=
AMAZON_MARKETPLACE=www.amazon.fr

# Redis credentials. Required by docker/docker-compose.yml, which sets this
# password on its Redis server (the compose files already enable Redis and set
# its host). Generate one with: openssl rand -hex 24
REDIS_PASSWORD=
REDIS_USERNAME=

# Optional server overrides (booleans and numbers are parsed as JSON)
# SERVER_DEBUG=true
# SERVER_CORS=false
# SERVER_RATE_LIMIT=120
# SERVER_SWAGGER=false
# SERVER_METRICS=false
# SERVER_CLICK_RATE_LIMIT=60
# Resilience against Amazon failures (see config/sample.yml)
# AMAZON_BREAKER_THRESHOLD=5
# AMAZON_BREAKER_COOLDOWN=60
# REDIS_STALE_EXPIRE=86400
# REDIS_NOT_FOUND_EXPIRE=3600
# Absolute project path, needed by `npm run dev` outside the dev container
# SERVER_PROJECT_DIR=/path/to/amw/

# Administration portal at <Server.path>/admin (usage statistics need Redis).
# The server refuses to start when it is enabled without a password of at
# least 12 characters. The secret signs the login tokens (random otherwise,
# which logs admins out on every restart).
# AMW_ADMIN_ENABLED=true
# AMW_ADMIN_PASSWORD=
# AMW_ADMIN_SECRET=
# AMW_ADMIN_TOKEN_TTL=3600
# AMW_ADMIN_LOGIN_RATE_LIMIT=10
# AI insights in the portal (Claude API, billed per analysis): the aggregated
# statistics are sent to Anthropic. Both lines are needed.
# AMW_ADMIN_INSIGHTS=true
# ANTHROPIC_API_KEY=
